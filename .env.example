# The First Hospitality Group - environment variables
# Copy to .env.local for local work. Never commit real values.
# Where each one is set: [V] Vercel, [C] Convex (`npx convex env set`), [G] GitHub Actions secret.

# --- App ---
# Public URL of the app, no trailing slash. [V][C]
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000
# Time zone for shifts, due times and windows. [C]
BUSINESS_TIMEZONE=America/New_York

# --- Convex ---
# Empty NEXT_PUBLIC_CONVEX_URL = preview mode with demo data (ADR 0010). [V]
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
CONVEX_DEPLOYMENT=
# Deploy key so Vercel and CI deploy Convex functions. [V][G]
CONVEX_DEPLOY_KEY=

# --- Auth (session bridge, ADR 0003) ---
# Issuer for the RS256 session and the Convex customJwt. [V][C]
AUTH_ISSUER=http://localhost:3000
# RS256 key pair, base64 PEM. Next.js only. Generate with `node scripts/setup-dev.mjs`. [V]
AUTH_PRIVATE_KEY=
AUTH_PUBLIC_KEY=
# Shared secret between Next.js route handlers and Convex bridge mutations. [V][C]
AUTH_BRIDGE_SECRET=

# --- Bootstrap (seed:bootstrap) ---
# First owner account; the password must be changed at first sign-in. [C]
BOOTSTRAP_OWNER_USERNAME=owner
BOOTSTRAP_OWNER_PASSWORD=
# Dev account with the role switcher; preview and local only, never production. [C]
DEV_ACCOUNT_PASSWORD=
# Lets accounts flagged isDev sign in on a cloud deployment (preview only). Never set in production. [C]
ALLOW_DEV_ACCOUNT=

# --- Web Push (ADR 0006) ---
# VAPID keys: `npx web-push generate-vapid-keys`. Public key is also exposed to the browser. [V][C]
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tech@example.com

# --- Email (Resend) ---
# Unset = emails are only logged. [C]
RESEND_API_KEY=
EMAIL_FROM="The First <notifications@example.com>"

# --- Monitoring (Sentry) ---
# Empty = off. [V]
NEXT_PUBLIC_SENTRY_DSN=
# Source map upload at build time, with the Sentry org and project slugs. [V]
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
